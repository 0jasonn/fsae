#include "engine/functions.h"
#include "game/doorsel_4.h"

// doorsel_dooropen (0x0202b18c): the door opening sequence after the selection. data_0212c4dc is the step (0..7), the
// ResultState block holds the timer (u16 at +4) and three animation bytes at +8, +9 and +0xa. The A button skips the
// waiting steps 2..4.
void doorsel_dooropen(void) {
    u8 *state = data_021349c0;
    u8 i;

    if (CommFrameSync() == 0) {
        return;
    }
    CommUpdateJoy();
    if ((data_0212c58c[0] & 1) && data_0212c4dc >= 2 && data_0212c4dc <= 4) {
        data_0212c4dc = 4;
        *(u16 *)(state + 4) = 1;
    }
    switch (data_0212c4dc) {
    case 0:
        SoundReq(0x3e);
        *(u16 *)(state + 4) = 0x1e;
        if (data_0212c7c8.unk_01 != 5 && data_0212c7c8.unk_01 != 6) {
            data_0212c4dc = data_0212c4dc + 1;
        } else {
            state[8] = 2;
            *(u16 *)(state + 4) = 0x28;
            data_0212c4dc = 5;
        }
        break;
    case 1:
        *(u16 *)(state + 4) = *(u16 *)(state + 4) - 1;
        if (*(u16 *)(state + 4) == 0) {
            data_0212c4dc = data_0212c4dc + 1;
            SoundReq(0xf);
            for (i = 0; i < data_0212c7c8.playerCount; i++) {
                *((u8 *)&data_0212ceb0[i] + 0xc) = 4;
                data_0212ceb0[i].stateTimer = 0xff;
            }
            state[9] = 0x20;
            GetSetWork(0x31, 0xb, 0);
            GetSetWork(0x31, 0xb, 1);
            GetSetWork(0x31, 0xb, 2);
            *(u16 *)(state + 4) = 0xb4;
        }
        break;
    case 2:
        *(u16 *)(state + 4) = *(u16 *)(state + 4) - 1;
        if (*(u16 *)(state + 4) == 0) {
            data_0212c4dc = data_0212c4dc + 1;
            state[0xa] = 4;
        }
        break;
    case 3:
        state[9] -= 1;
        if (state[9] < 0x18) {
            state[0xa] = 8;
        }
        if (state[9] < 8) {
            state[0xa] = 0xc;
            *(u16 *)(state + 4) = 0x78;
            data_0212c4dc = data_0212c4dc + 1;
        }
        break;
    case 4:
        *(u16 *)(state + 4) = *(u16 *)(state + 4) - 1;
        if (*(u16 *)(state + 4) == 0) {
            data_0212c4dc = data_0212c4dc + 1;
            CgLoad(0x23);
            GetSetWork(0x31, (u8)(state[2] + 5), 0);
            state[8] = 2;
            *(u16 *)(state + 4) = 0x28;
        }
        break;
    case 5:
        *(u16 *)(state + 4) = *(u16 *)(state + 4) - 1;
        if (*(u16 *)(state + 4) == 0) {
            data_0212c4dc = data_0212c4dc + 1;
            state[8] = 3;
        }
        break;
    case 6:
        if (state[8] == 4) {
            data_0212c4dc = data_0212c4dc + 1;
            *(u16 *)(state + 4) = 0x3c;
        }
        break;
    case 7:
        *(u16 *)(state + 4) = *(u16 *)(state + 4) - 1;
        if (*(u16 *)(state + 4) == 0) {
            data_0212c4dc = 0;
            data_0212c500 = data_0212c500 + 1;
            state[8] = 5;
            keyClear();
            return;
        }
        break;
    }
    CommFrameUpdate();
}
